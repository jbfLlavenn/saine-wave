{
  "manifest_version": 3,
  "name": "Saine Wave",
  "version": "1.20.0",
  "description": "Clip the songs from YouTube streams, loop them, and play them as playlists. Your songs sync through your browser account.",
  "key": "",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Saine Wave",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "early.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "kuromoji.js",
        "romaji.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon16.png",
        "icon32.png",
        "icon48.png",
        "icon128.png",
        "dict/*"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "host_permissions": [
    "https://lrclib.net/*"
  ]
}
